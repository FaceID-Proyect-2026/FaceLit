# Public client configuration only. Copy to .env without overwriting existing local settings.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_EMBEDDING_API_URL=http://localhost:8090
# Legacy direct-service integration only; this value is embedded in the client.
# Obtain a non-production development value from the service owner if required.
# Never place a private service credential in an EXPO_PUBLIC variable.
EXPO_PUBLIC_EMBEDDING_API_KEY=
